*.jpg filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.nc filter=lfs diff=lfs merge=lfs -text
/test_data/data/ filter=lfs diff=lfs merge=lfs -text

# Documentation assets stay out of LFS: .lfsconfig excludes LFS content from
# clones, and these must be present for the docs to build and render.
docs/examples/data/*.nc !filter !diff !merge -text
docs/source/_static/** !filter !diff !merge
